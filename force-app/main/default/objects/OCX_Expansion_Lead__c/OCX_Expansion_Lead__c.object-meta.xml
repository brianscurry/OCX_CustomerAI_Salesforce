<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>An OCX-qualified expansion signal for an existing Account, reviewed by Sales before Opportunity creation.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>true</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <label>Expansion Lead</label>
    <nameField><displayFormat>EL-{00000}</displayFormat><label>Expansion Lead Number</label><type>AutoNumber</type></nameField>
    <pluralLabel>Expansion Leads</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
</CustomObject>
